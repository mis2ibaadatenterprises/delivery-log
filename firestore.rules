rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function isMaster()  {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master';
    }

    // Profiles: you read and edit your own; the master reads and edits everyone's.
    match /users/{uid} {
      allow read:   if signedIn() && (request.auth.uid == uid || isMaster());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || isMaster());
      allow delete: if isMaster();
    }

    // Uploads: a delivery person creates and reads their own; the master sees all.
    match /entries/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read:   if signedIn() && (resource.data.uid == request.auth.uid || isMaster());
      allow update, delete: if isMaster();
    }

    // Version doc the app checks for updates. Master writes it, everyone reads it.
    match /config/{docId} {
      allow read:  if signedIn();
      allow write: if isMaster();
    }
  }
}
